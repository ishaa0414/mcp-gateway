{
  "name": "mcp-gateway",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @mcp-gateway/db run generate",
    "db:migrate": "pnpm --filter @mcp-gateway/db run migrate",
    "db:migrate:deploy": "pnpm --filter @mcp-gateway/db run migrate:deploy",
    "db:seed": "pnpm --filter @mcp-gateway/db run seed"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.8.1"
}
