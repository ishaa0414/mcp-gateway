# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mcpgateway"
# Separate DB for tests — never overwrites dev data
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/mcpgateway_test"

# Cap on Postgres connections per process (default 10). Lower it on hosted free-tier databases.
# DATABASE_POOL_MAX=5

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth.js v5 ────────────────────────────────────────────────────────────────
# v4 names (NEXTAUTH_SECRET, NEXTAUTH_URL, GITHUB_CLIENT_ID/SECRET) are NOT read.
# At least 32 characters: openssl rand -hex 32
AUTH_SECRET="replace-with-a-random-32-char-secret"
AUTH_URL="http://localhost:3000"

# GitHub OAuth app — create at https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# ── Encryption ────────────────────────────────────────────────────────────────
# AES-256-GCM key for upstream credentials at rest (32 bytes, hex-encoded = 64 chars)
ENCRYPTION_KEY="replace-with-64-hex-chars"

# ── Gateway ───────────────────────────────────────────────────────────────────
GATEWAY_PORT=4000
# Where agents reach the gateway; the dashboard shows this in its connection instructions.
GATEWAY_PUBLIC_URL="http://localhost:4000"
# Hosting platforms (Render, Koyeb, Fly) assign the port through PORT; GATEWAY_PORT wins if both are set.
# PORT=
WORKER_PORT=4001
# Optional tuning (defaults shown): one deadline for a whole upstream call, largest upstream response read,
# and how long cached project config / API key lookups live. Cache entries are also cleared on every dashboard edit.
# TOOL_CALL_TIMEOUT_MS=15000
# TOOL_RESPONSE_MAX_BYTES=1048576
# CONFIG_CACHE_TTL_SECONDS=300
# API_KEY_CACHE_TTL_SECONDS=30

# ── Call logging ──────────────────────────────────────────────────────────────
# Every tool call (and sampled auth failure / rate-limit rejection) is logged with masked arguments.
# queue: the gateway sends batches to BullMQ and the worker (apps/worker) writes them to Postgres.
# The worker must be running (pnpm dev starts it) or logs pile up in Redis.
# direct: no worker and no BullMQ; the gateway writes batches to Postgres itself and deletes old rows itself.
# Use direct where BullMQ's Redis polling is too expensive (a free Upstash plan).
# LOG_SINK=queue
# Call logs older than this are deleted (by the worker in queue mode, by the gateway in direct mode).
# LOG_RETENTION_DAYS=30
# In-memory buffer: events held before a write; when it is full, new events are dropped and counted.
# LOG_BUFFER_MAX=1000
# LOG_BATCH_SIZE=100
# LOG_FLUSH_INTERVAL_MS=2000
# How long shutdown (SIGTERM) keeps trying to write what is still buffered.
# LOG_SHUTDOWN_FLUSH_MS=5000

# ── Security ─────────────────────────────────────────────────────────────────
NODE_ENV="development"
# Set to "true" to allow localhost/private IP upstream URLs in development
# ALLOW_PRIVATE_UPSTREAMS="true"
