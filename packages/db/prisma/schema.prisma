generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

// ── Auth.js tables ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?   // bcrypt hash for email/password auth
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]
  projects Project[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ── App models ─────────────────────────────────────────────────────────────

model Project {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  name            String
  slug            String   @unique
  upstreamBaseUrl String   @map("upstream_base_url")
  openapiSpec     Json?    @map("openapi_spec")
  specHash        String?  @map("spec_hash")
  specVersion     String?  @map("spec_version")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  upstreamCredential UpstreamCredential?
  tools              Tool[]
  apiKeys            ApiKey[]
  toolCallLogs       ToolCallLog[]

  @@map("projects")
}

enum CredentialType {
  NONE
  BEARER
  CUSTOM_HEADER
  QUERY_PARAM
}

model UpstreamCredential {
  id             String         @id @default(cuid())
  projectId      String         @unique @map("project_id")
  type           CredentialType @default(NONE)
  encryptedValue String?        @map("encrypted_value")
  headerName     String?        @map("header_name")
  queryParamName String?        @map("query_param_name")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("upstream_credentials")
}

model Tool {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  operationId String   @map("operation_id")
  method      String
  path        String
  name        String
  description String   @db.Text
  // What the spec produced for name/description on the last import. A user edit
  // is `name != specName`; re-import only overwrites a field that still matches.
  specName        String @map("spec_name")
  specDescription String @map("spec_description") @db.Text
  inputSchema Json     @map("input_schema")
  enabled     Boolean   @default(true)
  hiddenParams Json     @default("{}") @map("hidden_params")
  removedAt   DateTime? @map("removed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  toolCallLogs ToolCallLog[]

  @@unique([projectId, operationId])
  // MCP clients address tools by name, so a name must identify exactly one tool.
  @@unique([projectId, name])
  @@map("tools")
}

model ApiKey {
  id              String    @id @default(cuid())
  projectId       String    @map("project_id")
  name            String
  prefix          String
  hash            String    @unique
  rateLimitPerMin Int       @default(60) @map("rate_limit_per_min")
  lastUsedAt      DateTime? @map("last_used_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  toolCallLogs ToolCallLog[]

  @@map("api_keys")
}

enum LogKind {
  TOOL_CALL
  AUTH_FAILURE
}

/// One row per tool call (and per sampled auth failure). The id is generated by the gateway
/// when the event happens, so a redelivered batch hits the primary key and is skipped.
/// Response bodies are never stored, only their size.
model ToolCallLog {
  id             String   @id
  kind           LogKind  @default(TOOL_CALL)
  projectId      String   @map("project_id")
  toolId         String?  @map("tool_id")
  // Snapshot of the name at call time; survives renames and removed tools.
  toolName       String?  @map("tool_name")
  apiKeyId       String?  @map("api_key_id")
  // Masked and truncated arguments the agent sent. `{}` for auth failures.
  input          Json
  upstreamStatus Int?     @map("upstream_status")
  latencyMs      Int      @map("latency_ms")
  success        Boolean
  // Values are validated by the LogErrorClass enum in @mcp-gateway/shared (text, so adding one needs no migration).
  errorClass     String?  @map("error_class")
  errorMessage   String?  @db.Text @map("error_message")
  responseBytes  Int?     @map("response_bytes")
  createdAt      DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tool    Tool?   @relation(fields: [toolId], references: [id], onDelete: SetNull)
  apiKey  ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  // Time series and recent calls for a project.
  @@index([projectId, createdAt])
  // Top tools and per-tool latency within a project.
  @@index([projectId, toolName, createdAt])
  // Retention deletes by age alone.
  @@index([createdAt])
  // Postgres does not index foreign keys; without these, deleting a tool or key (or a project, which
  // cascades to both) scans the whole log table to null the references.
  @@index([toolId])
  @@index([apiKeyId])
  @@map("tool_call_logs")
}
